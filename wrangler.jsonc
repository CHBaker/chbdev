{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chbdev",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [
    {
      "name": "CONTACT_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  "routes": [
    { "pattern": "chbdev.com", "custom_domain": true },
    { "pattern": "www.chbdev.com", "custom_domain": true }
  ]
}
